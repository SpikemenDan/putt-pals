{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "putt-pals-rooms",
  "main": "services/rooms/worker.mjs",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "exports": {
    "RoomDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ROOM_ENVIRONMENT": "development"
  },
  "env": {
    "preview": {
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api", "/api/*"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "RoomDurableObject"
          }
        ]
      },
      "exports": {
        "RoomDurableObject": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "vars": {
        "ROOM_ENVIRONMENT": "preview"
      }
    },
    "production": {
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api", "/api/*"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "RoomDurableObject"
          }
        ]
      },
      "exports": {
        "RoomDurableObject": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "vars": {
        "ROOM_ENVIRONMENT": "production"
      }
    }
  }
}
